rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isValidComplaintCreate() {
      let data = request.resource.data;
      return data.keys().hasAll(['title', 'description', 'category', 'location', 'urgency', 'status', 'createdAt', 'trackingId'])
        && data.title is string && data.title.size() >= 3 && data.title.size() <= 200
        && data.description is string && data.description.size() >= 5 && data.description.size() <= 5000
        && data.status in ['Reported', 'Acknowledged', 'In Progress', 'Resolved']
        && data.urgency in ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW']
        && data.trackingId is string && data.trackingId.size() >= 6;
    }

    function isCitizenUpvoteOnly() {
      let diff = request.resource.data.diff(resource.data);
      // Citizens are permitted to increment upvotes, upvoter fingerprints, or submit citizen feedback/ratings
      return diff.affectedKeys().hasOnly(['upvotes', 'upvoterFingerprints', 'publicImpactScore', 'citizenFeedback']);
    }

    // Complaints collection
    match /complaints/{complaintId} {
      // Public transparency: anyone can read complaint details
      allow read: if true;

      // Public submission: validated creation allowed for all citizens
      allow create: if isValidComplaintCreate();

      // Updates: authenticated admins have full management permissions;
      // unauthenticated public can only endorse/upvote or submit resolution feedback
      allow update: if isAuthenticated() || isCitizenUpvoteOnly();

      // Deletions: only authenticated administrators can remove or archive records
      allow delete: if isAuthenticated();
    }

    // Admin profiles & settings
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == adminId;
    }

    // Resolution audit trail & logs
    match /audit_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
